{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": { "rules": "database.rules.json" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    },
    {
      "source": "functions-manus-test",
      "codebase": "manus-test",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    },
    {
      "source": "functions-ai-room",
      "codebase": "ai-room",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "database": { "port": 9000 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false }
  }
}
