{
  "rules": {
    ".read": false,
    ".write": false,
    "mofumofuOnlinePresenceAccess": {
      "$roomId": {
        "$uid": {
          ".read": false,
          ".write": false
        }
      }
    },
    "mofumofuOnlinePresence": {
      "$roomId": {
        ".read": "auth != null && root.child('mofumofuOnlinePresenceAccess').child($roomId).child(auth.uid).child('uid').val() === auth.uid && root.child('mofumofuOnlinePresenceAccess').child($roomId).child(auth.uid).child('roomId').val() === $roomId && root.child('mofumofuOnlinePresenceAccess').child($roomId).child(auth.uid).child('expiresAt').val() > now",
        "$uid": {
          "connections": {
            "$connectionId": {
              ".write": "auth != null && $uid === auth.uid && root.child('mofumofuOnlinePresenceAccess').child($roomId).child(auth.uid).child('uid').val() === auth.uid && root.child('mofumofuOnlinePresenceAccess').child($roomId).child(auth.uid).child('roomId').val() === $roomId && (root.child('mofumofuOnlinePresenceAccess').child($roomId).child(auth.uid).child('expiresAt').val() > now || (data.exists() && data.child('uid').val() === auth.uid && newData.child('state').val() === 'disconnected')) && $connectionId.matches(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/)",
              ".validate": "newData.hasChildren(['uid', 'roomId', 'seatId', 'connectionId', 'state', 'lastHeartbeatAt', 'connectedAt']) && newData.child('uid').val() === auth.uid && newData.child('roomId').val() === $roomId && newData.child('seatId').val() === root.child('mofumofuOnlinePresenceAccess').child($roomId).child(auth.uid).child('seatId').val() && newData.child('connectionId').val() === $connectionId && (newData.child('state').val() === 'online' || newData.child('state').val() === 'disconnected') && newData.child('lastHeartbeatAt').isNumber() && newData.child('connectedAt').isNumber()",
              "uid": { ".validate": true },
              "roomId": { ".validate": true },
              "seatId": { ".validate": "newData.val() === 'A' || newData.val() === 'B'" },
              "connectionId": { ".validate": true },
              "state": { ".validate": true },
              "lastHeartbeatAt": { ".validate": true },
              "connectedAt": { ".validate": "!data.exists() || newData.val() === data.val()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "shadowCardRoomAccess": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && $uid === auth.uid && data.val() === true",
          ".write": false
        }
      }
    },
    "shadowCardPresence": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && root.child('shadowCardRoomAccess').child($roomId).child(auth.uid).val() === true",
          ".write": "auth != null && newData.exists() && $uid === auth.uid && root.child('shadowCardRoomAccess').child($roomId).child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['state', 'lastChanged'])",
          "state": {
            ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
          },
          "lastChanged": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "moonScaleDuelRoomAccess": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && $uid === auth.uid && data.val() === true",
          ".write": false
        }
      }
    },
    "moonScaleDuelPresence": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && root.child('moonScaleDuelRoomAccess').child($roomId).child(auth.uid).val() === true",
          ".write": "auth != null && newData.exists() && $uid === auth.uid && root.child('moonScaleDuelRoomAccess').child($roomId).child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['state', 'lastChanged'])",
          "state": {
            ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
          },
          "lastChanged": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
