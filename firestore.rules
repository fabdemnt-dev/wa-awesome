rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1) 訪問カウンタ counter/visits
    // ============================================================
    match /counter/{docId} {
      allow read: if true;
      allow create, update: if
          docId == 'visits'
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0;
      allow delete: if false;
    }

    // ============================================================
    // 2) ゲームの部屋 rooms/haiku_○○○ と rooms/poem_○○○
    // ============================================================
    match /rooms/{roomId} {
      function signedIn() {
        return request.auth != null;
      }
      allow read: if signedIn();
      // 新規ルームは作成者の匿名UIDと表示名を対応付ける。旧形式ルームは従来互換で許可する。
      allow create: if signedIn();
      // 個人データのUID単位制限は、クライアント側のデータキー移行後に追加する。
      // 現段階では新旧ルームのゲーム進行を壊さないため、認証済み更新を維持する。
      allow update: if signedIn();
      allow delete: if false;
    }

    // ルームの過去ラウンド履歴。現在状態とは別ドキュメントに保存する。
    match /rooms/{roomId}/history/{entryId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // ============================================================
    // 3) ワードセット wordsets
    //
    // 読み取りは公開。作成・編集・削除はCallable Functionだけが行う。
    // FunctionsはAdmin SDKを使うためRulesをバイパスし、クライアントは
    // 共有パスワードをサーバー側で照合しない限り変更できない。
    // ============================================================
    match /wordsets/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 編集履歴もFunctionsがワードセット変更と同一バッチで記録する。
    match /wordsets/{docId}/history/{entryId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // パスワードのbcryptハッシュを置く非公開コレクション。
    // クライアントは読み書きできず、Callable Functionのみが扱う。
    match /wordsetSecrets/{docId} {
      allow read, write: if false;
    }
  }
}
