rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function shadowCardSignedIn() { return request.auth != null; }
    function isShadowCardMember(roomId) {
      return shadowCardSignedIn()
        && exists(/databases/$(database)/documents/shadowCardRooms/$(roomId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/shadowCardRooms/$(roomId)/members/$(request.auth.uid)).data.leftAt == null;
    }

    match /shadowCardRooms/{roomId} {
      allow read: if isShadowCardMember(roomId);
      allow write: if false;
    }
    match /shadowCardRooms/{roomId}/{publicCollection}/{docId} {
      allow read: if isShadowCardMember(roomId)
        && publicCollection in ['members', 'seats', 'games', 'rounds', 'results'];
      allow write: if false;
    }
    match /shadowCardRooms/{roomId}/privatePlayers/{uid} {
      allow read: if shadowCardSignedIn()
        && request.auth.uid == uid
        && isShadowCardMember(roomId);
      allow write: if false;
    }
    match /shadowCardRooms/{roomId}/privatePlayers/{uid}/rounds/{roundId} {
      allow read: if shadowCardSignedIn()
        && request.auth.uid == uid
        && isShadowCardMember(roomId);
      allow write: if false;
    }
    match /shadowCardRooms/{roomId}/serverRounds/{docId} { allow read, write: if false; }
    match /shadowCardRoomLocators/{docId} { allow read, write: if false; }
    match /shadowCardRoomSecrets/{docId} { allow read, write: if false; }
    match /shadowCardRateLimits/{docId} { allow read, write: if false; }
    match /shadowCardActionRequests/{docId} { allow read, write: if false; }

    // 月秤の決闘オンライン版は、初版からすべてのゲーム状態を
    // Callable Functions経由で取得・変更する。Admin SDKだけがアクセスする。
    match /moonScaleDuelRooms/{roomId} {
      allow read, write: if false;
    }
    match /moonScaleDuelRooms/{roomId}/{document=**} {
      allow read, write: if false;
    }
    match /moonScaleDuelRoomLocators/{docId} { allow read, write: if false; }
    match /moonScaleDuelRoomSecrets/{docId} { allow read, write: if false; }
    match /moonScaleDuelRateLimits/{docId} { allow read, write: if false; }
    match /moonScaleDuelActionRequests/{docId} { allow read, write: if false; }

    match /deepMiningAgreementRooms/{roomId} { allow read, write: if false; }
    match /deepMiningAgreementRooms/{roomId}/{document=**} { allow read, write: if false; }
    match /deepMiningAgreementRoomLocators/{docId} { allow read, write: if false; }
    match /deepMiningAgreementActionRequests/{docId} { allow read, write: if false; }

    // もふもふ大集合！オンライン版。公開roomとmembersは参加者だけが読み、
    // ゲーム確定書込みはすべてCallable Functions (Admin SDK) に限定する。
    function mofumofuSignedIn() { return request.auth != null; }
    function isMofumofuMember(roomId) {
      return mofumofuSignedIn()
        && exists(/databases/$(database)/documents/mofumofuOnlineRooms/$(roomId)/members/$(request.auth.uid));
    }
    match /mofumofuOnlineRooms/{roomId} {
      allow read: if isMofumofuMember(roomId);
      allow write: if false;
    }
    match /mofumofuOnlineRooms/{roomId}/members/{uid} {
      allow read: if isMofumofuMember(roomId);
      allow write: if false;
    }
    match /mofumofuOnlineRooms/{roomId}/privateHands/{uid} {
      allow read: if mofumofuSignedIn() && request.auth.uid == uid && isMofumofuMember(roomId);
      allow write: if false;
    }
    match /mofumofuOnlineRooms/{roomId}/serverState/{document=**} { allow read, write: if false; }
    match /mofumofuOnlineRooms/{roomId}/{document=**} { allow read, write: if false; }
    match /mofumofuOnlineRoomInvites/{docId} { allow read, write: if false; }
    match /mofumofuOnlineRoomSecrets/{docId} { allow read, write: if false; }
    match /mofumofuOnlineRateLimits/{docId} { allow read, write: if false; }
    match /mofumofuOnlineActionRequests/{docId} { allow read, write: if false; }

    // ============================================================
    // 1) 訪問カウンタ counter/visits
    // ============================================================
    match /counter/{docId} {
      allow read: if true;
      allow create, update: if
          docId == 'visits'
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0;
      allow delete: if false;
    }

    // ============================================================
    // 2) ゲームの部屋 rooms/haiku_○○○ と rooms/poem_○○○
    // ============================================================
    match /rooms/{roomId} {
      function signedIn() {
        return request.auth != null;
      }

      function isV2HaikuRoom(data) {
        return roomId.matches('^haiku_.*') && data.get('schemaVersion', 1) == 2;
      }

      allow read: if signedIn();
      // v2俳句ルームの作成・更新は、参加者・親・設定を含めてCallable Functionsだけが行う。
      // v1俳句ルームとPoemルームは従来互換のクライアント書込みを維持する。
      allow create: if signedIn() && !isV2HaikuRoom(request.resource.data);
      allow update: if signedIn()
        && !isV2HaikuRoom(resource.data)
        && !isV2HaikuRoom(request.resource.data);
      allow delete: if false;
    }

    // ルームの過去ラウンド履歴。現在状態とは別ドキュメントに保存する。
    match /rooms/{roomId}/history/{entryId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // UID別の個人手札は本人だけが読める。書込みはCallable Functions（Admin SDK）のみ。
    match /rooms/{roomId}/hands/{handUid} {
      allow read: if request.auth != null && request.auth.uid == handUid;
      allow create, update, delete: if false;
    }

    // ============================================================
    // 3) ワードセット wordsets
    //
    // 読み取りは公開。作成・編集・削除はCallable Functionだけが行う。
    // FunctionsはAdmin SDKを使うためRulesをバイパスし、クライアントは
    // 共有パスワードをサーバー側で照合しない限り変更できない。
    // ============================================================
    match /wordsets/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 編集履歴もFunctionsがワードセット変更と同一バッチで記録する。
    match /wordsets/{docId}/history/{entryId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // パスワードのbcryptハッシュを置く非公開コレクション。
    // クライアントは読み書きできず、Callable Functionのみが扱う。
    match /wordsetSecrets/{docId} {
      allow read, write: if false;
    }
  }
}
