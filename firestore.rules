rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1) 訪問カウンタ counter/visits
    // ============================================================
    match /counter/{docId} {
      allow read: if true;
      allow create, update: if
          docId == 'visits'
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0;
      allow delete: if false;
    }

    // ============================================================
    // 2) ゲームの部屋 rooms/haiku_○○○ と rooms/poem_○○○
    // ============================================================
    match /rooms/{roomId} {
      function signedIn() {
        return request.auth != null;
      }

      function isV2HaikuRoom(data) {
        return roomId.matches('^haiku_.*') && data.get('schemaVersion', 1) == 2;
      }

      function hasSafeInitialHaikuState() {
        return request.resource.data.status == 'lobby'
          && request.resource.data.roundCount == 1
          && request.resource.data.get('words5', []).size() == 0
          && request.resource.data.get('words7', []).size() == 0
          && request.resource.data.get('hands5', {}).size() == 0
          && request.resource.data.get('hands7', {}).size() == 0
          && request.resource.data.get('deck5', []).size() == 0
          && request.resource.data.get('deck7', []).size() == 0
          && request.resource.data.get('phrases', {}).size() == 0
          && request.resource.data.get('phraseDetails', {}).size() == 0
          && request.resource.data.get('revealedPhrases', {}).size() == 0
          && request.resource.data.get('selfPraise', {}).size() == 0
          && request.resource.data.get('votes', {}).size() == 0
          && request.resource.data.get('voteRoles', {}).size() == 0
          && request.resource.data.get('scores', {}).size() == 0
          && request.resource.data.get('scoreHistory', []).size() == 0
          && request.resource.data.get('redraws', {}).size() == 0;
      }

      function keepsV2HaikuGameStateProtected() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'words5', 'words7', 'hands5', 'hands7', 'deck5', 'deck7',
          'phrases', 'phraseDetails', 'revealedPhrases', 'selfPraise',
          'votes', 'voteRoles', 'scores', 'scoreHistory', 'redraws',
          'roundCount', 'status'
        ]);
      }

      allow read: if signedIn();
      // 新規v2俳句ルームは空のロビー状態だけを許可し、ゲーム結果の持込みを防ぐ。
      // v1・Poemルームは従来互換の作成フローを維持する。
      allow create: if signedIn()
        && (!isV2HaikuRoom(request.resource.data) || hasSafeInitialHaikuState());
      // v2俳句ルームのゲーム状態はCallable Functionsだけが変更する。
      // 参加者・再接続用フィールドは既存クライアントフローのため更新を許可する。
      allow update: if signedIn()
        && ((!isV2HaikuRoom(resource.data) && !isV2HaikuRoom(request.resource.data))
          || (isV2HaikuRoom(resource.data)
            && isV2HaikuRoom(request.resource.data)
            && keepsV2HaikuGameStateProtected()));
      allow delete: if false;
    }

    // ルームの過去ラウンド履歴。現在状態とは別ドキュメントに保存する。
    match /rooms/{roomId}/history/{entryId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // UID別の個人手札は本人だけが読める。書込みはCallable Functions（Admin SDK）のみ。
    match /rooms/{roomId}/hands/{handUid} {
      allow read: if request.auth != null && request.auth.uid == handUid;
      allow create, update, delete: if false;
    }

    // ============================================================
    // 3) ワードセット wordsets
    //
    // 読み取りは公開。作成・編集・削除はCallable Functionだけが行う。
    // FunctionsはAdmin SDKを使うためRulesをバイパスし、クライアントは
    // 共有パスワードをサーバー側で照合しない限り変更できない。
    // ============================================================
    match /wordsets/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 編集履歴もFunctionsがワードセット変更と同一バッチで記録する。
    match /wordsets/{docId}/history/{entryId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // パスワードのbcryptハッシュを置く非公開コレクション。
    // クライアントは読み書きできず、Callable Functionのみが扱う。
    match /wordsetSecrets/{docId} {
      allow read, write: if false;
    }
  }
}
