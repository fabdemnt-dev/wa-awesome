rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1) 訪問カウンタ counter/visits
    // ============================================================
    match /counter/{docId} {
      allow read: if true;
      allow create, update: if
          docId == 'visits'
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0;
      allow delete: if false;
    }

    // ============================================================
    // 2) ゲームの部屋 rooms/haiku_○○○ と rooms/poem_○○○
    // ============================================================
    match /rooms/{roomId} {
      allow read: if true;
      // 参加者は匿名認証ユーザー。ルームのゲーム状態はクライアント間で共有更新する。
      // 複雑なデータ形式検査は既存データとの互換性を壊していたため、
      // ドキュメント容量だけを上限として、認証済みユーザーの作成・更新を許可する。
      allow create, update: if
          request.auth != null
          && request.resource.data.size() <= 1048576;
      allow delete: if false;
    }

    // ルームの過去ラウンド履歴。現在状態とは別ドキュメントに保存する。
    match /rooms/{roomId}/history/{entryId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ============================================================
    // 3) ワードセット wordsets
    //
    // 読み取りは公開。作成・編集・削除はCallable Functionだけが行う。
    // FunctionsはAdmin SDKを使うためRulesをバイパスし、クライアントは
    // 共有パスワードをサーバー側で照合しない限り変更できない。
    // ============================================================
    match /wordsets/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 編集履歴もFunctionsがワードセット変更と同一バッチで記録する。
    match /wordsets/{docId}/history/{entryId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // パスワードのbcryptハッシュを置く非公開コレクション。
    // クライアントは読み書きできず、Callable Functionのみが扱う。
    match /wordsetSecrets/{docId} {
      allow read, write: if false;
    }
  }
}
